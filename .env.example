# Local development / self-hosting only
PORT=3001

# Database (Turso / libSQL). Leave empty locally to use file:./local.db.
# REQUIRED on Vercel: a libsql:// URL (file: URLs are rejected on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only used by `npm run db:copy` (copy existing records into the Turso DB above)
# SOURCE_DATABASE_URL=file:./local.db
# SOURCE_AUTH_TOKEN=

# Authentication and verified company signup (REQUIRED to activate account creation)
# Comma-separated, exact domains only, e.g. example.com,subsidiary.com
AUTH_ALLOWED_DOMAINS=
# Optional exact approved addresses for staff without a company domain, e.g. employee@gmail.com
# Avoid adding gmail.com or outlook.com to AUTH_ALLOWED_DOMAINS, as that would permit anyone on that domain.
AUTH_ALLOWED_EMAILS=
# Public HTTPS origin used in verification links, e.g. https://tracker.example.com
APP_BASE_URL=
# Transactional verification email provider (Resend, with verified sending domain)
RESEND_API_KEY=
AUTH_FROM_EMAIL=
