
# Local development / self-hosting only
PORT=3001

# Database (Turso / libSQL). Leave empty locally to use file:./local.db.
# REQUIRED on Vercel: a libsql:// URL (file: URLs are rejected on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only used by `npm run db:copy` (copy existing records into the Turso DB above)
# SOURCE_DATABASE_URL=file:./local.db
# SOURCE_AUTH_TOKEN=
